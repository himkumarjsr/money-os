{
  "name": "finkoin",
  "version": "0.4.0",
  "private": true,
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project='Mobile Chrome'",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:webkit": "playwright test --project='Mobile Safari'",
    "test:all": "npm run test && npm run test:e2e",
    "docs:update": "npx tsx scripts/update-docs.ts",
    "check:secrets": "node scripts/check-server-secrets-scope.mjs",
    "pwa:icons": "node scripts/generate-icons.mjs",
    "pwa:splashes": "node scripts/generate-splashes.mjs",
    "pwa:assets": "node scripts/generate-icons.mjs && node scripts/generate-splashes.mjs",
    "og:placeholders": "node scripts/generate-og-placeholders.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@next/third-parties": "^16.2.6",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "groq-sdk": "^1.1.2",
    "jspdf": "^4.2.1",
    "next": "^14.2.35",
    "next-pwa": "^5.6.0",
    "pdf-parse": "^1.1.1",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^19.1.1",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "resend": "^6.12.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
