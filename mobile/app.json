{
  "expo": {
    "name": "Finkoin",
    "slug": "finkoin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "finkoin",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finkoin.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:www.finkoin.com",
        "applinks:finkoin.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      },
      "package": "com.finkoin.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "finkoin"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.finkoin.com",
              "pathPrefix": "/split/join"
            },
            {
              "scheme": "https",
              "host": "finkoin.com",
              "pathPrefix": "/split/join"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#534AB7",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#534AB7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finkoin needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Finkoin needs access to your camera so you can take a profile picture."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82e76ba1-3e55-4fe5-8b89-f13e2e2776d2"
      }
    },
    "owner": "himkumarjsr"
  }
}
