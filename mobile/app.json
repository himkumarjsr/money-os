{
  "expo": {
    "name": "Finkoin",
    "slug": "finkoin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "finkoin",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finkoin.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      },
      "package": "com.finkoin.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "finkoin"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#534AB7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finkoin needs access to your photos so you can set a profile picture.",
          "cameraPermission": "Finkoin needs access to your camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82e76ba1-3e55-4fe5-8b89-f13e2e2776d2"
      }
    },
    "owner": "himkumarjsr"
  }
}
