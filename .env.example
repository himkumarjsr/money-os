# Copy to `.env.local` for local development.
# Set the same keys in Vercel → Project → Settings → Environment Variables (Production / Preview / Development).
#
# ─── NEVER commit `.env.local` or paste live secrets into `.env.example` ───
#
# SERVER-ONLY (must NOT use NEXT_PUBLIC_ prefix — never import these in Client Components):
#   SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, GROQ_API_KEY
#
# BROWSER-EXPOSED (embedded in client bundles — safe only for designed-public values):
#   NEXT_PUBLIC_* (Supabase anon URL/key, Razorpay Key ID, GA Measurement ID, etc.)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server route `/api/ai/analyse`) ---
GROQ_API_KEY=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.finkoin.com
NEXT_PUBLIC_APP_NAME=Finkoin

# --- Razorpay ---
# Key ID: safe to expose to checkout script (also available via `/api/razorpay/checkout-config`).
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Secret: server-only; used in create-order + verify-payment.
RAZORPAY_KEY_SECRET=

# --- Optional dev / admin ---
NEXT_PUBLIC_SKIP_PAYMENT=
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_DEBUG_AI=
NEXT_PUBLIC_AI_TIMEOUT_MS=
NEXT_PUBLIC_FINKOIN_AGENT_CODE=

# --- Analytics (optional). Public ID only; omit to disable GA scripts. ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
