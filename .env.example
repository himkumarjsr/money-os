# Copy to .env.local for local dev. Set the same keys in Vercel → Settings → Environment Variables.
# Never commit real secrets.

# Razorpay (server — required for orders + signature verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Key ID for checkout script (public — same id as RAZORPAY_KEY_ID; optional if checkout-config falls back to RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# GA4 Measurement ID (public — Admin → Data streams → Web → Measurement ID, format G-xxxxxxxxxx). Omit to disable analytics scripts.
NEXT_PUBLIC_GA_MEASUREMENT_ID= G-M51JD9T400
