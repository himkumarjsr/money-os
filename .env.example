# Copy to `.env.local` for local development.
# Set the same keys in Vercel → Project → Settings → Environment Variables (Production / Preview / Development).
#
# ─── NEVER commit `.env.local` or paste live secrets into `.env.example` ───
#
# SERVER-ONLY (must NOT use NEXT_PUBLIC_ prefix — never import these in Client Components):
#   SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET, GROQ_API_KEY
#
# BROWSER-EXPOSED (embedded in client bundles — safe only for designed-public values):
#   NEXT_PUBLIC_* (Supabase anon URL/key, Razorpay Key ID, GA Measurement ID, etc.)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server routes) ---
# Analyse + tax document extract (`/api/ai/analyse`, `/api/tax/extract`)
GROQ_API_KEY=
# Optional tax-extract model overrides
# GROQ_TAX_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_TAX_VISION_MODEL=  # set when Groq offers a vision model again

# AES-256-GCM for health-check + tax extract numbers (64 hex chars = 32 bytes)
# ENCRYPTION_KEY=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.finkoin.com
NEXT_PUBLIC_APP_NAME=Finkoin

# --- Razorpay ---
# Key ID: safe to expose to checkout script (also available via `/api/razorpay/checkout-config`).
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Secret: server-only; used in create-order + verify-payment.
RAZORPAY_KEY_SECRET=

# --- Optional dev / admin ---
NEXT_PUBLIC_SKIP_PAYMENT=
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_DEBUG_AI=
NEXT_PUBLIC_AI_TIMEOUT_MS=
NEXT_PUBLIC_FINKOIN_AGENT_CODE=

# --- Analytics (optional). Public ID only; omit to disable GA scripts. ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Server-only private key from `npx web-push generate-vapid-keys`
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:)
WEB_PUSH_VAPID_SUBJECT=mailto:support@finkoin.com

# --- Notifications / cron / email ---
RESEND_API_KEY=
EMAIL_FROM=tips@finkoin.com
CRON_SECRET=

# --- Feedback: Google Form only (no Finkoin DB) ---
# When set, the Feedback button opens a modal that links to this Form; users submit there only.
# Get email alerts: Google Forms → Settings → Responses → email notifications for new responses.
# Leave empty to use the in-app wizard + Supabase `app_feedback` instead.
# NEXT_PUBLIC_FEEDBACK_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform

# --- Google Form mirror for `/api/feedback` (optional, server-only; only used with in-app wizard) ---
# Create a Google Form; link responses to a Sheet. Copy the formResponse URL from the form HTML
# or use "Prefilled link" to discover entry.* field IDs (Inspect → entry.XXXXXXXX).
# If GOOGLE_FEEDBACK_FORM_RESPONSE_URL is unset, feedback is only stored in Supabase `app_feedback`.
# GOOGLE_FEEDBACK_FORM_RESPONSE_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse
# GOOGLE_FEEDBACK_ENTRY_RATING=entry.___________
# GOOGLE_FEEDBACK_ENTRY_AREA=entry.___________
# GOOGLE_FEEDBACK_ENTRY_HIGHLIGHTS=entry.___________
# GOOGLE_FEEDBACK_ENTRY_IMPROVEMENTS=entry.___________
# GOOGLE_FEEDBACK_ENTRY_RECOMMEND=entry.___________
# GOOGLE_FEEDBACK_ENTRY_CONTEXT=entry.___________
# GOOGLE_FEEDBACK_ENTRY_USER_ID=entry.___________

# --- Playwright authenticated e2e (optional; never commit real passwords) ---
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
